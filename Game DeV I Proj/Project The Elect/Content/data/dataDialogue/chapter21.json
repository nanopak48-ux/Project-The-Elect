{
  "chapter": 21,
  "dialogues": [
    {
      "character": "Unknown",
      "text": "เป็นไงบ้างหลับสบายดีรึป่าว",
      "voiceline": "chap01_v01"
    },
    {
      "character": "Vier",
      "text": "หลับสนิทจนน่าแปลกใจเลยหล่ะ",
      "voiceline": "chap01_v02"
    },
    {
      "character": "Unknown",
      "text": "แน่นอนสิก็เตียงมันนุ่มยังไงหล่ะเจ้าทึ่ม",
      "voiceline": "chap01_v02"
    },
    {
      "character": "Unknown",
      "text": "เอาหล่ะๆ ไปทำงานได้แล้ว",
      "voiceline": "chap01_v02"
    },
    {
      "character": "Vier",
      "text": "อึก.. ฉันต้องไปเจอกับเจ้าสัตว์ประหลาดนั้นอีกแล้วหรอ",
      "voiceline": "chap01_v03"
    },
    {
      "character": "Unknown",
      "text": "ทำไปเถอะไอ่โง่ ถ้าอยากออกไปจากที่นี่",
      "voiceline": "chap01_v02"
    },
    {
      "character": "Unknown",
      "text": "นี่เป็นตัวสุดท้ายแล้วที่แกจะต้องวิจัย แล้วแกก็จะได้อิสรภาพคืน",
      "voiceline": "chap01_v03"
    },
    {
      "character": "Unknown",
      "text": "รีบๆไปทำได้แล้ว!",
      "voiceline": "chap01_v01"
    },
    {
      "character": "Vier",
      "text": "แล้วฉันจะเชื่อได้ไงว่าแกจะปล่อยฉันไป",
      "voiceline": "chap01_v02"
    },
    {
      "character": "Unknown",
      "text": "เลิกบ่นสักทีเถอะน่าฉันขอสาบานต่อเพื่อนมนุษญ์ด้วยกันเองเลย",
      "voiceline": "chap01_v03"
    },
    {
      "character": "Unknown",
      "text": "ไปที่ห้องสแกนได้แล้ว! อย่าลืมแฟรชไดรฟ์หล่ะ",
      "voiceline": "chap01_v02"
    }
  ]
}